{
  "agents": {
    "defaults": {
      "model": {
        "primary": "google/gemini-2.5-flash",
        "fallbacks": [
          "anthropic/claude-opus-4-6",
          "openai/gpt-4o"
        ]
      },
      "models": {
        "google/gemini-2.5-flash": {
          "alias": "flash"
        },
        "anthropic/claude-opus-4-6": {
          "alias": "opus"
        },
        "openai/gpt-4o": {
          "alias": "gpt4o"
        }
      }
    }
  },
  "gateway": {
    "port": 18789,
    "mode": "local",
    "bind": "loopback"
  },
  "channels": {
    "telegram": {
      "botToken": "TU_TELEGRAM_BOT_TOKEN_AQUI",
      "allowFrom": [
        "tu_username"
      ],
      "dmPolicy": "pairing"
    },
    "discord": {
      "token": "TU_DISCORD_BOT_TOKEN_AQUI",
      "allowFrom": [
        "tu_discord_user_id"
      ],
      "dmPolicy": "pairing"
    },
    "whatsapp": {
      "allowFrom": [
        "+1234567890"
      ],
      "dmPolicy": "pairing"
    }
  },
  "tools": {
    "sandbox": {
      "tools": {
        "allow": ["exec", "process", "read", "write", "edit", "apply_patch", "image", "browser", "canvas", "sessions_list", "sessions_history", "sessions_send", "sessions_spawn", "subagents", "session_status", "nodes", "cron"],
        "deny": []
      }
    },
    "elevated": {
      "enabled": true
    }
  },
  "browser": {
    "enabled": true
  }
}
